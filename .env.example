# Copiá este archivo como .env y completá los valores. El .env NO se sube a git.

PORT=3000

# ---------- Panel de administración ----------
# Usuario y contraseña del personal municipal y secreto para firmar la sesión.
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
SESSION_SECRET=pon-aqui-una-cadena-larga-y-aleatoria
SESSION_TTL_MIN=120

# ---------- Firebase (capa gratuita, Firestore) ----------
# Opción A: ruta al JSON de la cuenta de servicio (Firebase Console > Configuración del
#           proyecto > Cuentas de servicio > Generar nueva clave privada).
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Opción B (en lugar de A): el contenido del JSON en una sola línea.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

